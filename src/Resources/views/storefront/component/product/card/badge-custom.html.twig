{% set backgroundColor = customBadgeBackgroundColorConfiguration|default('') %}
{% set fontColor = customBadgeFontColorConfiguration|default('') %}

{% if not customSetBadgeColorsViaConfiguration %}
    {% set backgroundColor = customFields[customBadgeBackgroundColorValue]|default('') %}
    {% set fontColor = customFields[customBadgeFontColorValue]|default('') %}
{% endif %}
{% set hasValidBackgroundColor = backgroundColor matches '/^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/' %}
{% set hasValidFontColor = fontColor matches '/^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/' %}

<div>
    <span class="badge bg-custom bg-custom-{{ numberBadges }}"{% if hasValidBackgroundColor or hasValidFontColor %} style="{% if hasValidBackgroundColor %}background-color: {{ backgroundColor|e('html_attr') }};{% endif %}{% if hasValidFontColor %}color: {{ fontColor|e('html_attr') }};{% endif %}"{% endif %}>
        {% block page_product_detail_buy_container_inner_custom_badge %}
            {{ "sschreier.badgenavigationproductdetailpage.badgeText"|trans({"%badgetext%": customFields[customBadgeTextValue]})|sw_sanitize }}
        {% endblock %}
    </span>
</div>
