{% sw_extends '@Storefront/storefront/element/cms-element-image-gallery.html.twig' %}

{% block element_image_gallery_inner_wrapper %}
    {% set product = page.product %}
    {% set customFields = product.translated.customFields|default({}) %}
    {% set numberBadgesValue = product.extensions['numberBadgesValue'].value|default(5) %}
    {% set badgeConfigPrefix = 'SschreierBadgeNavigationProductDetailPage.config.' %}
    {% set showAnyDetailBadge =
        config(badgeConfigPrefix ~ 'ShowDiscountBadgeOnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowTopsellerBadgeOnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowNewBadgeOnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowOosBadgeOnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowBadgeOnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowBadge2OnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowBadge3OnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowBadge4OnProductDetailPage')
        or config(badgeConfigPrefix ~ 'ShowBadge5OnProductDetailPage')
    %}

    {% block element_image_gallery_inner_wrapper_before %}
        {% block element_image_gallery_inner_wrapper_div_container_begin %}
            {% if showAnyDetailBadge %}<div class="product-badges-detail">{% endif %}
        {% endblock %}

        {% block element_image_gallery_inner_wrapper_component_product_badges_discount %}
            {% if config(badgeConfigPrefix ~ 'ShowDiscountBadgeOnProductDetailPage') %}
                {% set price = product.calculatedPrices.count > 0 ? product.calculatedPrices.last : product.calculatedPrice %}
                {% set listPrice = price.listPrice.percentage > 0 %}
                {% set hasRange = product.calculatedPrices.count > 1 %}
                {% set displayParent = product.variantListingConfig.displayParent and product.parentId is null %}
                {% set displayFromVariants = displayParent and price.unitPrice !== product.calculatedCheapestPrice.unitPrice %}

                {% if listPrice and not hasRange and not displayFromVariants %}
                    <div class="badge bg-danger badge-discount">
                        <span class="visually-hidden">{{ "sschreier.badgenavigationproductdetailpage.boxLabelDiscount"|trans|sw_sanitize }}</span>
                        <span aria-hidden="true">{{ "sschreier.badgenavigationproductdetailpage.boxLabelDiscount"|trans|sw_sanitize }}</span>
                    </div>
                {% endif %}
            {% endif %}
        {% endblock %}

        {% block element_image_gallery_inner_wrapper_component_product_badges_topseller %}
            {% if config(badgeConfigPrefix ~ 'ShowTopsellerBadgeOnProductDetailPage') and product.markAsTopseller %}
                <div>
                    <span class="badge bg-warning badge-topseller">{{ "listing.boxLabelTopseller"|trans|sw_sanitize }}</span>
                </div>
            {% endif %}
        {% endblock %}

        {% block element_image_gallery_inner_wrapper_component_product_badges_new %}
            {% if config(badgeConfigPrefix ~ 'ShowNewBadgeOnProductDetailPage') and product.isNew %}
                <div>
                    <span class="badge bg-success badge-new">{{ "listing.boxLabelNew"|trans|sw_sanitize }}</span>
                </div>
            {% endif %}
        {% endblock %}

        {% block element_image_gallery_inner_wrapper_component_product_badges_out_of_stock %}
            {% set isAvailable = not product.isCloseout or product.stock >= product.minPurchase %}

            {% if config(badgeConfigPrefix ~ 'ShowOosBadgeOnProductDetailPage') and not isAvailable %}
                {% sw_include '@SschreierBadgeNavigationProductDetailPage/storefront/component/product/card/badge-out-of-stock.html.twig' %}
            {% endif %}
        {% endblock %}

        {% block element_image_gallery_inner_wrapper_custom_badge %}
            {% for numberBadges in 1..numberBadgesValue %}
                {% set badgeConfigNumber = numberBadges > 5 ? 1 : numberBadges %}
                {% set badgeConfigSuffix = badgeConfigNumber == 1 ? '' : badgeConfigNumber %}
                {% set showBadge = config(badgeConfigPrefix ~ 'ShowBadge' ~ badgeConfigSuffix ~ 'OnProductDetailPage') %}
                {% set customSetBadgeColorsViaConfiguration = config(badgeConfigPrefix ~ 'SetBadge' ~ badgeConfigSuffix ~ 'ColorsViaConfiguration') %}
                {% set customBadgeBackgroundColorConfiguration = config(badgeConfigPrefix ~ 'Badge' ~ badgeConfigSuffix ~ 'BackgroundColorConfiguration') %}
                {% set customBadgeFontColorConfiguration = config(badgeConfigPrefix ~ 'Badge' ~ badgeConfigSuffix ~ 'FontColorConfiguration') %}

                {% block element_image_gallery_inner_wrapper_custom_badge_inner %}
                    {% set customBadgeTextValue = 'sschreier_badges_badge' ~ numberBadges ~ '_text' %}
                    {% set customBadgeBackgroundColorValue = 'sschreier_badges_badge' ~ numberBadges ~ '_backgroundcolor' %}
                    {% set customBadgeFontColorValue = 'sschreier_badges_badge' ~ numberBadges ~ '_fontcolor' %}

                    {% if showBadge and customFields[customBadgeTextValue]|default(false) %}
                        {% sw_include '@SschreierBadgeNavigationProductDetailPage/storefront/component/product/card/badge-custom.html.twig' with {
                            numberBadges: numberBadges,
                            customFields: customFields,
                            customBadgeTextValue: customBadgeTextValue,
                            customBadgeBackgroundColorValue: customBadgeBackgroundColorValue,
                            customBadgeFontColorValue: customBadgeFontColorValue,
                            customSetBadgeColorsViaConfiguration: customSetBadgeColorsViaConfiguration,
                            customBadgeBackgroundColorConfiguration: customBadgeBackgroundColorConfiguration,
                            customBadgeFontColorConfiguration: customBadgeFontColorConfiguration
                        } %}
                    {% endif %}
                {% endblock %}
            {% endfor %}
        {% endblock %}

        {% block element_image_gallery_inner_wrapper_div_container_end %}
            {% if showAnyDetailBadge %}</div>{% endif %}
        {% endblock %}
    {% endblock %}

    {{ parent() }}

    {% block element_image_gallery_inner_wrapper_after %}{% endblock %}
{% endblock %}
